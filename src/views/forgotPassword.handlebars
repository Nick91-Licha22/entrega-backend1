<div class="container mt-5">
    <h2>¿Olvidaste tu contraseña?</h2>
    <p>Ingresá tu email y te enviaremos un link para restablecerla.</p>
    <form id="forgotForm">
        <input type="email" name="email" class="form-control mb-3" placeholder="Tu email" required>
        <button type="submit" class="btn btn-success">Enviar Mail</button>
    </form>
</div>

<script>
    document.getElementById('forgotForm').onsubmit = async (e) => {
        e.preventDefault();
        const data = new FormData(e.target);
        const obj = Object.fromEntries(data);
        const res = await fetch('/api/sessions/forgot-password', {
            method: 'POST',
            body: JSON.stringify(obj),
            headers: {'Content-Type': 'application/json'}
        });
        if(res.ok) alert('Mail enviado. Revisá tu casilla.');
        else alert('Error al enviar el mail.');
    }
</script>