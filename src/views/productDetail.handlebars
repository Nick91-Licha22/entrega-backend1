<div class="container mt-5">
    <div class="card shadow p-4 border-0 rounded-4">
        <div class="row align-items-center">
            <div class="col-md-6 text-center">
                <img src="/img/{{product.thumbnail}}" class="img-fluid rounded-4 shadow-sm" alt="{{product.title}}" 
                     style="max-height: 400px; width: 100%; object-fit: cover;"
                     onerror="this.src='https://via.placeholder.com/600x400?text=Imagen+No+Disponible'">
            </div>
            <div class="col-md-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/products">Catálogo</a></li>
                        <li class="breadcrumb-item active text-capitalize">{{product.category}}</li>
                    </ol>
                </nav>
                <h1 class="text-success fw-bold display-5">{{product.title}}</h1>
                <p class="lead text-muted">{{product.description}}</p>
                <hr>
                <div class="d-flex align-items-baseline mb-4">
                    <h2 class="text-dark fw-bold mb-0">${{product.price}}</h2>
                    <span class="ms-2 text-muted">/ Kilo</span>
                </div>
                <p class="text-muted"><i class="bi bi-box"></i> Stock disponible: <strong>{{product.stock}}</strong> unidades</p>

                <div class="d-grid gap-3 mt-4">
                    {{#if cartId}}
                        <button onclick="addToCart('{{cartId}}', '{{product._id}}')" 
                                class="btn btn-success btn-lg shadow fw-bold py-3">
                            🛒 Agregar al Carrito
                        </button>
                    {{else}}
                        <a href="/login" class="btn btn-warning btn-lg shadow fw-bold py-3">
                            🔑 Iniciá sesión para comprar
                        </a>
                    {{/if}}
                    <a href="/products" class="btn btn-outline-secondary">Volver al catálogo</a>
                </div>
            </div>
        </div>
    </div>
</div>