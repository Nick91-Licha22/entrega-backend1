<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <img src="/img/{{product.thumbnail}}" class="img-fluid rounded shadow" alt="{{product.title}}" onerror="this.src='https://via.placeholder.com/600x400?text=Imagen+No+Disponible'">
        </div>
        <div class="col-md-6">
            <h1 class="text-success fw-bold">{{product.title}}</h1>
            <span class="badge bg-success mb-3 fs-6">{{product.category}}</span>
            <p class="lead">{{product.description}}</p>
            <h2 class="text-dark fw-bold mb-4">${{product.price}} <small class="text-muted fs-6">/ Kilo</small></h2>
            <p class="text-muted">Stock disponible: {{product.stock}} unidades</p>

            {{#if cartId}}
                <button 
                    onclick="addToCart('{{cartId}}', '{{product._id}}')" 
                    class="btn btn-success btn-lg mt-3 w-100 shadow">
                    🛒 Agregar al Carrito
                </button>
            {{else}}
                <a href="/login" class="btn btn-warning btn-lg mt-3 w-100 shadow">
                    🔑 Iniciá sesión para comprar
                </a>
            {{/if}}
            
            <a href="/products" class="btn btn-outline-secondary mt-3 w-100">Volver al catálogo</a>
        </div>
    </div>
</div>

