<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 text-center">
            <img src="/img/{{product.thumbnail}}" class="img-fluid rounded shadow-lg border" alt="{{product.title}}" style="max-height: 500px; width: auto;">
        </div>
        <div class="col-md-6">
            <h1 class="text-success fw-bold">{{product.title}}</h1>
            <p class="badge bg-info text-dark fs-6">{{product.category}}</p>
            <hr>
            <h3 class="text-danger fw-bold">Precio: ${{product.price}}</h3>
            
            <div class="mt-4">
                <h5><strong>Descripción:</strong></h5>
                <p class="text-muted lead">{{product.description}}</p>
            </div>

            <div class="alert alert-secondary d-inline-block py-2 px-3">
                <strong>Stock disponible:</strong> {{product.stock}} unidades
            </div>
            
            <p><small class="text-muted d-block mt-2">Código de referencia: {{product.code}}</small></p>
            
            <div class="d-grid gap-3 mt-4">
                <button onclick="addToCart('{{product._id}}')" class="btn btn-success btn-lg shadow">
                     Agregar al Carrito
                </button>
                <a href="/products" class="btn btn-outline-secondary btn-lg">
                    Volver al catálogo
                </a>
            </div>
        </div>
    </div>
</div>
<script src="/js/cart.js"></script>