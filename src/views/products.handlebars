<div>
    <h1>Bienvenido, {{user.first_name}}</h1>
    <a href="/api/sessions/logout" style="color: red;">Cerrar Sesión</a>
    <hr>
    <a href="/carts/{{cartId}}" style="background: #28a745; color: white; padding: 10px; text-decoration: none; border-radius: 5px;">
        🛒 Ir a mi Carrito
    </a>
</div>

<h2>Catálogo de Productos</h2>
<div style="display: flex; flex-wrap: wrap; gap: 20px;">
    {{#each products}}
        <div style="border: 1px solid #ccc; padding: 15px; width: 200px; border-radius: 8px;">
            <h3>{{this.title}}</h3>
            <p>{{this.description}}</p>
            <p><strong>Precio: ${{this.price}}</strong></p>
            <p>Stock: {{this.stock}}</p>
            <button onclick="addToCart('{{../cartId}}', '{{this._id}}')" style="cursor: pointer; background: #007bff; color: white; border: none; padding: 8px; border-radius: 4px;">
                Agregar al carrito
            </button>
        </div>
    {{/each}}
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    async function addToCart(cartId, productId) {
        if (!cartId || cartId === "null") {
            return Swal.fire("Error", "No tienes un carrito asignado", "error");
        }

        try {
            const response = await fetch(`/api/carts/${cartId}/product/${productId}`, {
                method: 'POST'
            });
            const result = await response.json();
            
            if (result.status === "success") {
                Swal.fire({
                    title: "¡Agregado!",
                    text: "Producto sumado al carrito",
                    icon: "success",
                    timer: 1500
                });
            }
        } catch (error) {
            console.error("Error:", error);
        }
    }
</script>