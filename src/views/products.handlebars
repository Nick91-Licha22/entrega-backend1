<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-success fw-bold">S&N Verdulería 🍎</h1>
        <a href="/carts/{{cartId}}" class="btn btn-warning fw-bold px-4">🛒 Mi Carrito</a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        {{#each products}}
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="text-center bg-light" style="height: 180px;">
                    {{#if this.thumbnail}}
                        <img src="/img/{{this.thumbnail}}" class="h-100 w-100" style="object-fit: cover;" alt="{{this.title}}">
                    {{else}}
                        <div class="py-5 fs-1">🥗</div>
                    {{/if}}
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="fw-bold">{{this.title}}</h5>
                    <p class="text-muted small flex-grow-1">{{this.description}}</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h4 fw-bold text-success mb-0">${{this.price}}</span>
                        <span class="text-secondary small">Stock: {{this.stock}}</span>
                    </div>
                    <button onclick="addToCart('{{../cartId}}', '{{this._id}}')" class="btn btn-success mt-3 fw-bold w-100">
                        + Agregar al carrito
                    </button>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</div>