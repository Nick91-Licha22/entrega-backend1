<body data-cartid="{{cartId}}">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="text-success fw-bold">Nuestros Productos</h1>
        </div>

        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            {{#each products}}
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                    <div class="text-center bg-light" style="height: 180px;">
                        <img src="{{this.displayImage}}" 
                             class="h-100 w-100" 
                             style="object-fit: cover;" 
                             alt="{{this.title}}">
                    </div>
                    <div class="card-body d-flex flex-column text-center">
                        <h5 class="fw-bold">{{this.title}}</h5>
                        <p class="text-muted small flex-grow-1">{{this.description}}</p>
                        <div class="d-flex justify-content-between align-items-center px-2">
                            <span class="h4 fw-bold text-success mb-0">${{this.price}}</span>
                            <span class="text-secondary small">Stock: {{this.stock}}</span>
                        </div>
                        <div class="d-grid gap-2 mt-3">
                            <a href="/product/{{this._id}}" class="btn btn-info text-white fw-bold">Ver Detalle</a>
                            <button onclick="addToCart('{{../cartId}}', '{{this._id}}')" class="btn btn-success fw-bold">
                                + Agregar al carrito
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</body>