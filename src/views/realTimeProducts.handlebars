<script src="/socket.io/socket.io.js"></script>

<div class="row g-4 realtime-content">
    <div class="col-12">
        <h1 class="realtime-title"> Productos en Tiempo Real (SYN VERDULERÍA)</h1>
        <p class="lead">Agrega o elimina productos y observa cómo la lista se actualiza al instante en todos los
            clientes conectados.</p>
    </div>

    <div class="col-lg-4 col-md-5">
        <div class="card shadow-sm p-3 border-primary">
            <h3 class="card-title text-primary">Agregar Nuevo Producto</h3>
            <form id="productForm">
                <div class="mb-3">
                    <label for="title" class="form-label">Título</label>
                    <input type="text" class="form-control" id="title" name="title" required>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Descripción</label>
                    <input type="text" class="form-control" id="description" name="description" required>
                </div>
                <div class="mb-3">
                    <label for="price" class="form-label">Precio</label>
                    <input type="number" class="form-control" id="price" name="price" required>
                </div>
                <div class="mb-3">
                    <label for="code" class="form-label">Código</label>
                    <input type="text" class="form-control" id="code" name="code" required>
                </div>
                <div class="mb-3">
                    <label for="stock" class="form-label">Stock</label>
                    <input type="number" class="form-control" id="stock" name="stock" required>
                </div>
                <div class="mb-3">
                    <label for="category" class="form-label">Categoría</label>
                    <input type="text" class="form-control" id="category" name="category" required>
                </div>
                <div class="mb-3">
                    <label for="thumbnail" class="form-label">Nombre de Imagen (ej:
                        manzana.jpeg)</label>
                    <input type="text" class="form-control" id="thumbnail" name="thumbnail">
                </div>
                <button type="submit" class="btn btn-primary w-100">Agregar Producto</button>
            </form>
        </div>
    </div>

    <div class="col-lg-8 col-md-7">
        <h3 class="text-success">Catálogo de Productos</h3>
        <div id="productsContainer" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            {{#each products}}
            <div class="col product-card-container" id="product-card-{{this.id}}">
                <div class="card product-card">
                    <img src="/img/{{this.thumbnail}}" class="card-img-top" alt="{{this.title}}">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">{{this.title}}</h5>
                        <p class="card-subtitle mb-2 text-muted small">ID: {{this.id}} |
                            Código: {{this.code}}</p>
                        <p class="card-text">{{this.description}}</p>
                        <p class="card-text mt-auto">
                            <strong>Precio: ${{this.price}}</strong> | Stock:
                            {{this.stock}}
                        </p>
                        <span class="badge bg-success mb-2 align-self-start">{{this.category}}</span>
                        <button class="btn btn-danger btn-sm w-100" onclick="deleteProduct('{{this.id}}')">Eliminar
                            Producto</button>
                    </div>
                </div>
            </div>
            {{else}}
            <p class="text-muted">No hay productos cargados.</p>
            {{/each}}
        </div>
    </div>
</div>
<script src="/js/realTimeProducts.js"></script>