<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SYN VERDULERÍA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .navbar-custom { background-color: #28a745; } 
        .card-img-top { height: 200px; object-fit: cover; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-success shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/products">SYN VERDULERÍA</a>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item"><a class="nav-link" href="/products">Inicio</a></li>
                    {{#if user}}
                        <li class="nav-item">
                            <a class="nav-link btn btn-warning text-dark ms-lg-3 px-3" href="/carts/{{user.cart}}">
                                🛒 Mi Carrito
                            </a>
                        </li>
                        <li class="nav-item"><a class="nav-link ms-3" href="/api/sessions/logout">Cerrar Sesión</a></li>
                    {{else}}
                        <li class="nav-item"><a class="nav-link" href="/login">Ingresar</a></li>
                    {{/if}}
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4">
        {{{body}}}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/cart.js"></script>
</body>
</html>