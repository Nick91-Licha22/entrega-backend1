<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>S&N VERDULERÍA - Frescura Natural</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; background-color: #f8f9fa; }
        .navbar-custom { background-color: #2d5a27 !important; } 
        .card { border: none; transition: transform 0.3s; border-radius: 15px; }
        .card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
        .btn-success { background-color: #28a745; border: none; border-radius: 10px; }
        .btn-warning { background-color: #ffc107; border: none; font-weight: bold; }
        .badge-cart { position: absolute; top: -5px; right: -5px; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="/products">
                <span style="font-size: 1.5rem; margin-right: 10px;">🥗</span> S&N VERDULERÍA
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item"><a class="nav-link" href="/products">Productos</a></li>
                    {{#if user}}
                        <li class="nav-item">
                            <a class="nav-link btn btn-warning text-dark ms-lg-3 px-4 position-relative" href="/carts/{{user.cart}}">
                                🛒 Mi Carrito
                            </a>
                        </li>
                        <li class="nav-item"><a class="nav-link ms-3 text-white-50" href="/api/sessions/logout">Cerrar Sesión</a></li>
                    {{else}}
                        <li class="nav-item"><a class="nav-link btn btn-outline-light px-4" href="/login">Ingresar</a></li>
                    {{/if}}
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-5">
        {{{body}}}
    </main>

    <footer class="text-center py-4 text-muted">
        <small>&copy; 2026 S&N Verdulería - Calidad Premium</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/cart.js"></script>
</body>
</html>