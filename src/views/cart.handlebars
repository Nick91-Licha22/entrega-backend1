<div class="container mt-5">
    <h2 class="text-success mb-4 text-center">Tu Pedido en S&N Verdulería</h2>

    {{#if products.length}}
    <div class="row">
        <div class="col-md-8">
            {{#each products}}
            <div class="card mb-3 shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title">{{this.product.title}}</h5>
                        <p class="text-muted mb-0">{{this.quantity}} Kg - Precio x Kg: ${{this.product.price}}</p>
                    </div>
                    <button class="btn btn-danger btn-sm" onclick="removeFromCart('{{../cartId}}', '{{this.product._id}}')">Quitar</button>
                </div>
            </div>
            {{/each}}
        </div>
        <div class="col-md-4">
            <div class="card p-4 shadow">
                <h4>Total: <span class="text-success">${{total}}</span></h4>
                <button class="btn btn-success w-100 mt-3 fw-bold" onclick="finalizePurchase('{{cartId}}')">FINALIZAR COMPRA ✅</button>
            </div>
        </div>
    </div>
    {{else}}
    <div class="text-center mt-5">
        <h3>Tu carrito está vacío</h3>
        <a href="/products" class="btn btn-outline-success mt-3">Ver catálogo</a>
    </div>
    {{/if}}
</div>

<script>
    const finalizePurchase = async (cartId) => {
        Swal.fire({
            title: 'Procesando pago...',
            didOpen: () => Swal.showLoading()
        });

        const response = await fetch(`/api/carts/${cartId}/purchase`, { method: 'POST' });
        const data = await response.json();

        if (response.ok) {
            Swal.fire({
                icon: 'success',
                title: '¡Compra Exitosa!',
                html: `
                    <div class="text-left">
                        <p><strong>Código de Ticket:</strong> ${data.payload.code}</p>
                        <p><strong>Total pagado:</strong> $${data.payload.amount}</p>
                        <p><strong>Fecha:</strong> ${new Date(data.payload.purchase_datetime).toLocaleString()}</p>
                    </div>
                `,
                confirmButtonText: 'Volver al Inicio'
            }).then(() => window.location.href = '/products');
        } else {
            Swal.fire('Error', data.error || 'No se pudo procesar la compra por falta de stock', 'error');
        }
    };
</script>