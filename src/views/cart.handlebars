<div class="container">
    <h2 class="text-success mb-4 fw-bold">🛒 Detalle de tu Pedido</h2>

    {{#if products.length}}
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 p-3">
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light text-muted small uppercase">
                            <tr>
                                <th>PRODUCTO</th>
                                <th class="text-center">CANTIDAD</th>
                                <th class="text-end">SUBTOTAL</th>
                                <th class="text-center">ACCIONES</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each products}}
                            <tr>
                                <td>
                                    <div class="fw-bold">{{this.product.title}}</div>
                                    <small class="text-muted">Precio: ${{this.product.price}}</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-success px-3">{{this.quantity}} Un.</span>
                                </td>
                                <td class="text-end fw-bold text-success">
                                    ${{multiply this.quantity this.product.price}}
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-outline-danger btn-sm border-0" 
                                            onclick="removeFromCart('{{../cartId}}', '{{this.product._id}}')">
                                        Eliminar 🗑️
                                    </button>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card p-4 shadow border-0 bg-white rounded-4">
                <h4 class="fw-bold mb-4 border-bottom pb-2">Resumen Total</h4>
                <div class="d-flex justify-content-between mb-2 fs-5">
                    <span>Total a pagar:</span>
                    <span class="fw-bold text-success">${{total}}</span>
                </div>
                <p class="small text-muted mb-4">Los productos se descontarán del stock al finalizar.</p>
                
                <button class="btn btn-success btn-lg w-100 py-3 fw-bold shadow" 
                        onclick="finalizePurchase('{{cartId}}')">
                    FINALIZAR COMPRA ✅
                </button>
            </div>
        </div>
    </div>

    {{else}}
    <div class="text-center py-5">
        <h3 class="fw-bold">Tu carrito está vacío</h3>
        <a href="/products" class="btn btn-success px-5 mt-3">Ir a comprar</a>
    </div>
    {{/if}}
</div>