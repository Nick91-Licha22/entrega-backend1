<div class="row g-4">
    <div class="col-12">
        <h1 class="text-success"> Catálogo de Productos - SYN VERDULERÍA</h1>
        <p class="lead">Bienvenido a nuestra tienda. Productos frescos y de temporada.</p>
    </div>

    <div class="col-12">
        <h3 class="text-success">Frutas y Verduras Disponibles</h3>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            {{#each products}}
            <div class="col product-card-container">
                <div class="card product-card">
                    <img src="/img/{{this.thumbnail}}" class="card-img-top" alt="{{this.title}}">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">{{this.title}}</h5>
                        <p class="card-text">{{this.description}}</p>
                        <p class="card-text mt-auto">
                            <strong>Precio: ${{this.price}}</strong> | Stock:
                            {{this.stock}}
                        </p>
                        <span class="badge bg-secondary mb-2 align-self-start">{{this.category}}</span>
                        <button class="btn btn-outline-success btn-sm w-100">Agregar al
                            Carrito</button>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</div>