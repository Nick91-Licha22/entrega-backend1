<div class="row g-4">
    <div class="col-12 text-center">
        <h1 class="text-success">Catálogo de Productos - SYN VERDULERÍA</h1>
        <p class="lead">Productos frescos directamente a tu mesa.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mt-2">
        {{#each products}}
        <div class="col">
            <div class="card h-100 shadow-sm border-success">
                <img src="/img/{{this.thumbnail}}" class="card-img-top" alt="{{this.title}}" style="height: 200px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-success">{{this.title}}</h5>
                    <p class="card-text text-truncate">{{this.description}}</p>
                    <p class="mt-auto"><strong>Precio: ${{this.price}}</strong></p>
                    <div class="d-grid gap-2">
                        <a href="/products/{{this._id}}" class="btn btn-outline-success btn-sm">Ver Detalles</a>
                        <button onclick="addToCart('{{this._id}}')" class="btn btn-success btn-sm">
                            Agregar al Carrito
                        </button>
                    </div>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
    <nav class="mt-5">
        <ul class="pagination justify-content-center">
            {{#if pagination.hasPrevPage}}
            <li class="page-item">
                <a class="page-link text-success" href="?page={{pagination.prevPage}}">Anterior</a>
            </li>
            {{/if}}

            <li class="page-item disabled">
                <span class="page-link text-dark">Página {{pagination.page}} de {{pagination.totalPages}}</span>
            </li>

            {{#if pagination.hasNextPage}}
            <li class="page-item">
                <a class="page-link text-success" href="?page={{pagination.nextPage}}">Siguiente</a>
            </li>
            {{/if}}
        </ul>
    </nav>
</div>

<script src="/js/cart.js"></script>