<h1>Mis Productos</h1>

<div>
    {{#each products}}
        <div class="product-card">
            <h3>{{this.title}}</h3>
            <p>{{this.description}}</p>
            <p>Precio: ${{this.price}}</p>
            
            {{#if this.thumbnail}}
                <img src="/img/{{this.thumbnail}}" alt="{{this.title}}">
            {{/if}}

        </div>
    {{/each}}
</div>